<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#14161c">

    <!-- Top Preview Bar matching Spck Editor style -->
    <LinearLayout
        android:id="@+id/preview_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1e222d"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/preview_btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#d6d8df"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to editor" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preview"
                android:textColor="#f0f2f5"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/preview_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preview · 100% Zoom"
                android:textColor="#9096a6"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right action icons: Console, Refresh, Menu -->
        <TextView
            android:id="@+id/preview_btn_console"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="&gt;_"
            android:typeface="monospace"
            android:textStyle="bold"
            android:textColor="#60b6f5"
            android:textSize="14sp"
            android:background="#272c38"
            android:layout_marginEnd="8dp"
            android:contentDescription="Developer Console" />

        <TextView
            android:id="@+id/preview_btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#d6d8df"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="4dp"
            android:contentDescription="Refresh preview" />

        <TextView
            android:id="@+id/preview_btn_menu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#d6d8df"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options" />
    </LinearLayout>

    <!-- Progress indicator -->
    <ProgressBar
        android:id="@+id/preview_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Web content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ffffff">

        <WebView
            android:id="@+id/preview_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
